// Title: Security Tools Keyword Lookup Via Findstr.EXE
// Author: Nasreddine Bencherchali (Nextron Systems), frack113, MalGamy (Nextron Systems)
// Date: 2023-10-20
// Level: medium
// Description: Detects execution of "findstr" or "find" to search for common names of security tools. Attackers often pipe the results of recon commands such as "tasklist" or "whoami" to "findstr" in order to filter out the results.
// This detection focuses on the keywords that the attacker might use as a filter.
// MITRE Tactic: Discovery
// Tags: attack.discovery, attack.t1518.001
// Reference: https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_findstr_security_keyword_lookup.yml

DeviceProcessEvents
| where ((FolderPath endswith "\\find.exe" or FolderPath endswith "\\findstr.exe") or (ProcessVersionInfoOriginalFileName in~ ("FIND.EXE", "FINDSTR.EXE"))) and ((ProcessCommandLine contains " aswidsagent " or ProcessCommandLine contains " aswidsagent\"" or ProcessCommandLine contains " avast " or ProcessCommandLine contains " avast\"" or ProcessCommandLine contains " avastui " or ProcessCommandLine contains " avastui\"" or ProcessCommandLine contains " avg " or ProcessCommandLine contains " avg\"" or ProcessCommandLine contains " avgui " or ProcessCommandLine contains " avgui\"" or ProcessCommandLine contains " avira " or ProcessCommandLine contains " avira\"" or ProcessCommandLine contains " avp " or ProcessCommandLine contains " avp\"" or ProcessCommandLine contains " bdagent " or ProcessCommandLine contains " bdagent\"" or ProcessCommandLine contains " bdservicehost " or ProcessCommandLine contains " bdservicehost\"" or ProcessCommandLine contains " bitdefender " or ProcessCommandLine contains " bitdefender\"" or ProcessCommandLine contains " cb " or ProcessCommandLine contains " cb\"" or ProcessCommandLine contains " cbdefense " or ProcessCommandLine contains " cbdefense\"" or ProcessCommandLine contains " ccsvchst " or ProcessCommandLine contains " ccsvchst\"" or ProcessCommandLine contains " carbonblack " or ProcessCommandLine contains " carbonblack\"" or ProcessCommandLine contains " checkpoint " or ProcessCommandLine contains " checkpoint\"" or ProcessCommandLine contains " cisco " or ProcessCommandLine contains " cisco\"" or ProcessCommandLine contains " coreframeworkhost " or ProcessCommandLine contains " coreframeworkhost\"" or ProcessCommandLine contains " cortex " or ProcessCommandLine contains " cortex\"" or ProcessCommandLine contains " crow " or ProcessCommandLine contains " crow\"" or ProcessCommandLine contains " csagent " or ProcessCommandLine contains " csagent\"" or ProcessCommandLine contains " csfalcon " or ProcessCommandLine contains " csfalc